---
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/url';
import InstrumentVelgar from '../components/InstrumentVelgar.astro';

interface Props {
  tittel?: string;
  skildring?: string;
  /** Vis instrumentvelgaren (stemming og nøkkel). */
  instrument?: boolean;
}
const { tittel, skildring = SITE.undertittel, instrument = true } = Astro.props;
const fullTittel = tittel ? `${tittel} · ${SITE.namn}` : SITE.namn;
const her = Astro.url.pathname;
const aktiv = (p: string) => (her === url(p) ? 'page' : undefined);
---
<!doctype html>
<html lang="nn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTittel}</title>
    <meta name="description" content={skildring} />
    <meta name="theme-color" content="#8c2f39" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body>
    <a class="hopp" href="#innhald">Hopp til innhald</a>
    <header class="topp">
      <div class="omslag topp__inne">
        <a class="logo" href={url('/')}>
          <img src={url('favicon.svg')} alt="" width="32" height="32" />
          <span>{SITE.namn}</span>
        </a>
        <nav aria-label="Hovudmeny">
          <a href={url('/')} aria-current={aktiv('/')}>Trekk</a>
          <a href={url('ovingar/')} aria-current={aktiv('ovingar/')}>Alle øvingar</a>
        </nav>
      </div>
    </header>
    {instrument && <InstrumentVelgar />}

    <main id="innhald" class="omslag">
      <slot />
    </main>

    <footer class="fot">
      <div class="omslag">
        <p>Dagens Dobbel er gratis og open for alle. Set du pris på det, kan du støtte vidare arbeid.</p>
        <a class="bmc" href={SITE.bmcUrl} target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">☕</span> Kjøp meg ein kaffi
        </a>
      </div>
    </footer>
  </body>
</html>
