---
import type { CollectionEntry } from 'astro:content';
import { KATEGORIAR, STANDARD_STEMMING, STEMMINGAR } from '../site.config';
import { url } from '../lib/url';
import { avled } from '../lib/musikk';
import { filerFor, filerJson } from '../lib/filer';

interface Props {
  entry: CollectionEntry<'ovingar'>;
  /** Vis "bytt"-knapp (trekk-sida). */
  trekk?: boolean;
  /** Vis lenke til eigen øvingsside. */
  lenke?: boolean;
}
const { entry, trekk = false, lenke = true } = Astro.props;
const d = entry.data;
const a = avled(d);
const f = filerFor(entry.id);
const kat = KATEGORIAR[d.kategori];
const nivaaNamn = ['', 'Nybyrjar', 'Middels', 'Viderekomen'][d.nivaa];
---
<article
  class={`kort kort--${d.kategori}`}
  data-id={entry.id}
  data-kat={d.kategori}
  data-nivaa={d.nivaa}
  data-filer={filerJson(entry.id)}
>
  <p class="kort__kat">{kat.namn}</p>
  <h3 class="kort__tittel">{d.tittel}</h3>
  <p class="kort__fokus">{d.fokus}</p>

  <ul class="meta">
    <li><span class="prikkar" role="img" aria-label={`Nivå ${d.nivaa} av 3`}>{'●'.repeat(d.nivaa)}{'○'.repeat(3 - d.nivaa)}</span> {nivaaNamn}</li>
    {a.toneart && <li>{a.toneart.namn}</li>}
    {d.tempo && <li>{d.tempoEining} = {d.tempo}</li>}
    {a.lagast && a.hogast && <li>{a.lagast.tekst}–{a.hogast.tekst}</li>}
    <li>Rytme: {a.rytme.tekst}</li>
    {d.varigheit && <li>ca. {d.varigheit} min</li>}
  </ul>

  {d.tips && <p class="kort__tips"><strong>Tips:</strong> {d.tips}</p>}

  <div class="lyd">
    <p class="lyd__merke" data-lydmerke>Lydfil for {STEMMINGAR[STANDARD_STEMMING].merke}-instrument</p>
    <audio controls preload="none" src={f.lyd[STANDARD_STEMMING]}>
      Nettlesaren din støttar ikkje lydavspeling.
    </audio>
  </div>
  <p class="instr-merknad" data-instr-merknad role="note" hidden></p>

  <div class="knappar">
    <a class="knapp knapp--fylt" href={f.noter.g} data-noter-lenke target="_blank" rel="noopener">Opne notar (PDF)</a>
    {lenke && <a class="knapp" href={url(`ovingar/${entry.id}/`)}>Øvingsside</a>}
    {trekk && <button class="knapp" type="button" data-bytt>Bytt denne</button>}
  </div>
</article>
